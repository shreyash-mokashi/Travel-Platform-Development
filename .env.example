# ---------------------------------------------------------------------------
# Voyago - root environment template.
# Copy to .env (root), apps/api/.env and apps/web/.env.local as described in
# README.md. This file contains PLACEHOLDERS ONLY - never commit real secrets.
# ---------------------------------------------------------------------------

# --- Infrastructure (used by infrastructure/docker-compose.yml) -------------
POSTGRES_USER=voyago
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=voyago
POSTGRES_PORT=5434

MONGO_PORT=27018
MONGO_DB=voyago_content

# --- API (apps/api/.env) ----------------------------------------------------
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://voyago:change_me_local_only@localhost:5434/voyago?schema=public
MONGODB_URI=mongodb://localhost:27018/voyago_content

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_base64_48
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Per-minute budget for login and registration. Keep this at 10 in production;
# raise it locally and in CI, where the browser suite signs up many accounts
# from one address.
AUTH_THROTTLE_LIMIT=10
LOG_LEVEL=info

# Seeded demo accounts - passwords are generated at seed time and printed once.
# Set these only if you want deterministic local demo credentials.
SEED_DEMO_CUSTOMER_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=

# --- Web (apps/web/.env.local) ---------------------------------------------
# Browser-visible base URL of the API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side (RSC / route handler) base URL of the API
API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
